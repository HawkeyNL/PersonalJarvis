# Copy to .env and adjust. NEVER commit .env with real secrets.
# Consumed by services/api via the JARVIS_ prefix (see crates/config).

JARVIS_DATABASE_URL=postgres://jarvis:jarvis_dev_pw@localhost:5432/jarvis
JARVIS_BIND_ADDR=0.0.0.0:8080
JARVIS_LOG_JSON=false
JARVIS_ENVIRONMENT=development

# --- Jarvis-brein / LLM (DEC-001 = Claude; zie decisions/ADR-022) ---
# De API-sleutel leeft ALLEEN hier in de backend — nooit in de client/webview/logs.
# provider (zie ADR-027):
#   "router"/"auto" — SLIM: kiest per taak het goedkoopste-geschikte brein en
#     raadpleegt de live registry voor beschikbaarheid. Simpel → Ollama (gratis);
#     echt werk → jouw plan (claude CLI); plan vol/onbereikbaar → API (vangnet);
#     het zwaarste → alleen sterke breinen. Aanbevolen.
#   "claude-cli" — jouw Claude-abonnement via de lokale `claude` CLI, met de API
#     (of Ollama) als vangnet als de CLI faalt/vol is.
#   "anthropic" — cloud-API, met Ollama als lokaal vangnet.
#   "ollama" — alleen lokaal.
JARVIS_LLM_PROVIDER=router
JARVIS_LLM_API_KEY=
# Pad/naam van de `claude` CLI (alleen voor provider=claude-cli).
JARVIS_LLM_CLAUDE_CLI_BIN=claude
JARVIS_LLM_ANTHROPIC_BASE_URL=https://api.anthropic.com
# Tiers: standaard-brein / zwaar redeneren / snel-en-goedkoop
JARVIS_LLM_MODEL=claude-sonnet-5
JARVIS_LLM_MODEL_HARD=claude-opus-5
JARVIS_LLM_MODEL_CHEAP=claude-haiku-4-5
JARVIS_LLM_MAX_TOKENS=1024
# Lokale fallback (optioneel): draai `ollama serve` en `ollama pull llama3.2`
JARVIS_LLM_OLLAMA_URL=http://localhost:11434
JARVIS_LLM_OLLAMA_MODEL=llama3.2

# --- Stem (server-side STT + speaker-verificatie; zie decisions/ADR-025) ---
# provider: "stub" (deterministisch) of "whisper" (echt STT via whisper.cpp).
# Voor "whisper": bouw de backend met --features speech-whisper (vereist cmake:
# `brew install cmake`) en haal een model via scripts/fetch-whisper-model.sh.
JARVIS_SPEECH_PROVIDER=stub
# Cosine-drempel waarboven een stem als de ingeschreven spreker geldt (per model tunen).
JARVIS_SPEECH_VERIFY_THRESHOLD=0.5
# Whisper GGML-model + decodeertaal (nl of auto). Alleen gebruikt bij provider=whisper.
JARVIS_SPEECH_WHISPER_MODEL=models/ggml-base.bin
JARVIS_SPEECH_WHISPER_LANGUAGE=nl
