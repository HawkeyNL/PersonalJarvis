# Copy to .env and adjust. NEVER commit .env with real secrets.
# Consumed by jarvis-api via the JARVIS_ prefix (see crates/config).

# Database-scoped account for Core; do not give Core the Surreal root password.
JARVIS_SURREAL_ENDPOINT=127.0.0.1:8000
JARVIS_SURREAL_NAMESPACE=jarvis
JARVIS_SURREAL_DATABASE=core
JARVIS_SURREAL_USERNAME=core
JARVIS_SURREAL_PASSWORD=replace-with-a-strong-secret
JARVIS_BIND_ADDR=0.0.0.0:8080
JARVIS_LOG_JSON=false
JARVIS_ENVIRONMENT=development
# Dev-only /v1/auth/enroll registers any caller's key on the owner account.
# Off by default; Core refuses to start with it in production.
JARVIS_DEV_ENROLLMENT=false

# --- Jarvis-brein / LLM (DEC-001 = Claude; see decisions/ADR-022) ---
# The API key lives ONLY here in the backend — never in the client/webview/logs.
# provider (see ADR-027):
#   "router"/"auto" — first picks the minimum required quality, then a healthy
#     model the owner has explicitly enabled. An API key on its own never
#     activates a cloud model; manage the allowlist with
#     `sudo jarvis-models refresh|enable|disable` on the Home Node.
#   "claude-cli" — your Claude subscription via the local `claude` CLI, with the API
#     (or Ollama) as fallback if the CLI fails or is at its limit.
#   "anthropic" — cloud API, with Ollama as local fallback.
#   "ollama" — local only.
JARVIS_LLM_PROVIDER=router
JARVIS_LLM_API_KEY=
# Path/name of the `claude` CLI (only for provider=claude-cli).
JARVIS_LLM_CLAUDE_CLI_BIN=claude
# Jarvis' identity/persona: the source of truth for "what Jarvis is". Loaded
# as the system prompt at startup. If the file is missing → built-in fallback.
# Protected production persona. It is separately installed from the private
# PersonalJarvisAgents checkout and is never part of a public release artifact.
JARVIS_LLM_PERSONA_PATH=/etc/jarvis/Jarvis.md
JARVIS_LLM_ANTHROPIC_BASE_URL=https://api.anthropic.com
# Tiers: default brain / heavy reasoning / fast-and-cheap
JARVIS_LLM_MODEL=claude-sonnet-5
JARVIS_LLM_MODEL_HARD=claude-opus-5
JARVIS_LLM_MODEL_CHEAP=claude-haiku-4-5
JARVIS_LLM_MAX_TOKENS=1024
# Local fallback (optional): run `ollama serve` and `ollama pull llama3.2`
JARVIS_LLM_OLLAMA_URL=http://localhost:11434
JARVIS_LLM_OLLAMA_MODEL=llama3.2
# Root-managed Home Node policy; development may point at a synthetic fixture.
JARVIS_LLM_MODEL_POLICY_PATH=/etc/jarvis/model-policy.json

# --- Extra brains for the router (all optional; empty = off) ---
# Keys stay ONLY here in the backend. In router mode Jarvis splits the work:
# free local/plan where possible, the cheapest suitable API as fallback.
# OpenAI (per-token):
JARVIS_LLM_OPENAI_API_KEY=
JARVIS_LLM_OPENAI_BASE_URL=https://api.openai.com/v1
JARVIS_LLM_OPENAI_MODEL=gpt-4o
JARVIS_LLM_OPENAI_MODEL_HARD=gpt-4o
JARVIS_LLM_OPENAI_MODEL_CHEAP=gpt-4o-mini
# DeepSeek (OpenAI-compatible, very cheap):
JARVIS_LLM_DEEPSEEK_API_KEY=
JARVIS_LLM_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
JARVIS_LLM_DEEPSEEK_MODEL=deepseek-chat
JARVIS_LLM_DEEPSEEK_MODEL_HARD=deepseek-reasoner
JARVIS_LLM_DEEPSEEK_MODEL_CHEAP=deepseek-chat
# xAI/Grok and Z.ai/GLM are OpenAI-compatible only when an owner configures
# their official endpoint and exact model IDs. Keys are installed through
# `sudo jarvis-credentials set <provider>` on production, never committed here.
JARVIS_LLM_XAI_API_KEY=
JARVIS_LLM_XAI_BASE_URL=https://api.x.ai/v1
JARVIS_LLM_XAI_MODEL=
JARVIS_LLM_XAI_MODEL_HARD=
JARVIS_LLM_XAI_MODEL_CHEAP=
JARVIS_LLM_ZAI_API_KEY=
JARVIS_LLM_ZAI_BASE_URL=https://api.z.ai/api/paas/v4
JARVIS_LLM_ZAI_MODEL=
JARVIS_LLM_ZAI_MODEL_HARD=
JARVIS_LLM_ZAI_MODEL_CHEAP=
# This is a remote credentialed API, deliberately not the local Ollama service.
JARVIS_LLM_OLLAMA_CLOUD_API_KEY=
JARVIS_LLM_OLLAMA_CLOUD_BASE_URL=
JARVIS_LLM_OLLAMA_CLOUD_MODEL=
JARVIS_LLM_OLLAMA_CLOUD_MODEL_HARD=
JARVIS_LLM_OLLAMA_CLOUD_MODEL_CHEAP=
JARVIS_LLM_HUGGINGFACE_API_KEY=
JARVIS_LLM_HUGGINGFACE_BASE_URL=https://router.huggingface.co/v1
JARVIS_LLM_HUGGINGFACE_MODEL=
JARVIS_LLM_HUGGINGFACE_MODEL_HARD=
JARVIS_LLM_HUGGINGFACE_MODEL_CHEAP=
JARVIS_LLM_HUGGINGFACE_ROUTE=fastest
JARVIS_LLM_HUGGINGFACE_ROUTE_CHEAP=cheapest
JARVIS_LLM_HUGGINGFACE_ROUTE_HARD=preferred
JARVIS_LLM_HUGGINGFACE_CATALOG_PATH=/etc/jarvis/huggingface-catalog.json

# --- Spending cap (hard stop on paid APIs) ---
# Once Jarvis reaches this monthly amount (EUR) across all metered APIs combined,
# the router refuses paid calls and falls back to your plan (claude CLI) + Ollama (free).
# Your plan does NOT count (already paid for); only per-token APIs count.
JARVIS_LLM_MONTHLY_BUDGET_EUR=50
# At the soft threshold the router may use a cheaper *qualifying* model; the
# hard monthly/request limits never silently downgrade task quality.
JARVIS_LLM_MONTHLY_SOFT_BUDGET_EUR=40
JARVIS_LLM_REQUEST_HARD_CAP_EUR=5
# Exchange rate to convert provider prices (USD) to the EUR budget.
JARVIS_LLM_EUR_PER_USD=0.92

# --- Voice (server-side STT + speaker verification; see decisions/ADR-025) ---
# provider: "stub" (deterministic) or "whisper" (real STT via whisper.cpp).
# For "whisper": build the backend with --features speech-whisper (requires cmake:
# `brew install cmake`) and fetch a model via scripts/fetch-whisper-model.sh.
JARVIS_SPEECH_PROVIDER=stub
# Cosine threshold above which a voice counts as the enrolled speaker (tune per model).
JARVIS_SPEECH_VERIFY_THRESHOLD=0.5
# Whisper GGML model + decode language (nl or auto). Only used with provider=whisper.
JARVIS_SPEECH_WHISPER_MODEL=models/ggml-base.bin
JARVIS_SPEECH_WHISPER_LANGUAGE=nl

# --- Agentic execution (ADR-029, phase 4a–4b; code execution via ADR-040) ---
# Kill switch. OFF by default: Jarvis has no hands until you deliberately turn this on.
# Read-only actions (ls/cat/grep/git-status) run autonomously + audited (4a);
# mutations (write_file/git_commit) go behind a device-signed approval
# per action (4b). Secrets + the Core are never accessible.
JARVIS_AGENT_ENABLED=false
# Sandbox root: the only directory Jarvis may look at/work in. Empty = off.
JARVIS_AGENT_WORKSPACE_ROOT=

# Legacy compatibility only: direct host-process Claude Code stays disabled even
# when this flag is true. ADR-040 replaces it with an OpenSandbox-backed broker.
JARVIS_AGENT_CLAUDE_CODE_ENABLED=false
# Retained for compatibility; not consumed by the direct executor.
JARVIS_AGENT_CLAUDE_CODE_BIN=claude
# Retained for compatibility.
JARVIS_AGENT_CLAUDE_CODE_MODEL=

# --- Auth rate-limiting (security hardening, Priority 2) — per client-IP ---
# Generous defaults for a single user; lowering them makes it stricter.
JARVIS_AUTH_RATE_ENROLL_PER_MIN=10
JARVIS_AUTH_RATE_CHALLENGE_PER_MIN=30
JARVIS_AUTH_RATE_LOGIN_PER_MIN=20
# After this many failed logins within the lockout window the IP is rejected.
JARVIS_AUTH_LOGIN_MAX_FAILURES=5
JARVIS_AUTH_LOGIN_LOCK_SECS=300
# Trusted proxy hops in front of the API. 0 = NEVER trust X-Forwarded-For (use the
# socket peer). Set to N only if the API is reachable exclusively via N trusted proxies.
# Then JARVIS_TRUSTED_PROXY_IPS MUST list the direct proxy peer(s); the proxy must
# also overwrite incoming X-Forwarded-For headers. RivetLink is not a proxy unless
# the actual connection meets these conditions.
JARVIS_TRUSTED_PROXY_HOPS=0
# Comma-separated IP addresses, for example 127.0.0.1,::1. Empty = no proxy
# trusted; with HOPS > 0 Jarvis Core refuses to start without this allowlist.
JARVIS_TRUSTED_PROXY_IPS=
