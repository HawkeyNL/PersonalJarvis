[Unit]
Description=Jarvis privileged configuration broker
After=network-online.target jarvis-surrealdb.service
Wants=network-online.target

[Service]
Type=exec
User=root
Group=jarvis
EnvironmentFile=/etc/jarvis/core.env
RuntimeDirectory=jarvis-config-broker
RuntimeDirectoryMode=0750
# Replay markers live outside Core's writable /var/lib/jarvis tree, so Core
# cannot rename or reset them. Markers from an older release below
# /var/lib/jarvis/config-broker are not read. Approvals expire within five
# minutes, so only an approval used in the five minutes before this upgrade
# (or a rollback) could be replayed once; Core could already reset that path.
StateDirectory=jarvis-config-broker
StateDirectoryMode=0700
ExecStart=/opt/jarvis/current/jarvis-config-broker
Restart=on-failure
RestartSec=5s
TimeoutStartSec=20s
UMask=0077
NoNewPrivileges=true
CapabilityBoundingSet=CAP_CHOWN CAP_FOWNER CAP_DAC_OVERRIDE
LockPersonality=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
# RuntimeDirectory=/StateDirectory= make these two narrowly scoped trees
# writable even with ProtectSystem=strict. Atomic policy replacement requires
# sibling staging and rename in this separate, root-owned directory; no access
# to the protected parent directory or Core environment is granted.
ReadWritePaths=/etc/jarvis/model-policy

[Install]
WantedBy=multi-user.target
