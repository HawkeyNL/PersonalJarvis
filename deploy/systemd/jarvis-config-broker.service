[Unit]
Description=Jarvis privileged configuration broker
After=network-online.target jarvis-surrealdb.service
Wants=network-online.target

[Service]
Type=exec
User=root
Group=jarvis
EnvironmentFile=/etc/jarvis/core.env
RuntimeDirectory=jarvis-config-broker
RuntimeDirectoryMode=0750
StateDirectory=jarvis/config-broker
StateDirectoryMode=0700
ExecStart=/opt/jarvis/current/jarvis-config-broker
Restart=on-failure
RestartSec=5s
TimeoutStartSec=20s
UMask=0077
NoNewPrivileges=true
CapabilityBoundingSet=CAP_CHOWN CAP_FOWNER CAP_DAC_OVERRIDE
LockPersonality=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
# RuntimeDirectory=/StateDirectory= make these two narrowly scoped trees
# writable even with ProtectSystem=strict; only the policy file needs an
# explicit host exception.
ReadWritePaths=/etc/jarvis/model-policy.json

[Install]
WantedBy=multi-user.target
