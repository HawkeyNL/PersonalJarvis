[Unit]
Description=Jarvis Core API
Wants=network-online.target
After=network-online.target jarvis-surrealdb.service

[Service]
Type=exec
User=jarvis
Group=jarvis
WorkingDirectory=/opt/jarvis/current
EnvironmentFile=/etc/jarvis/core.env
ExecStart=/opt/jarvis/current/jarvis-api
Restart=on-failure
RestartSec=5s
TimeoutStartSec=30s
TimeoutStopSec=30s
UMask=0077

# Core owns no host files at runtime: durable application state is SurrealDB.
# Keep the release read-only and make host compromise harder without granting
# arbitrary sudo or Docker access to the process.
NoNewPrivileges=true
CapabilityBoundingSet=
LockPersonality=true
RestrictSUIDSGID=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
ReadWritePaths=/var/lib/jarvis
# Agent releases are a root-activated read-only subtree even though Core may
# retain unrelated runtime state below /var/lib/jarvis.
ReadOnlyPaths=/var/lib/jarvis/agents

[Install]
WantedBy=multi-user.target
