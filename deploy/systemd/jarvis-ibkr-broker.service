[Unit]
Description=Jarvis read-only IBKR broker
After=network-online.target
Wants=network-online.target
# Set up by `sudo jarvis-credentials set ibkr-oauth`; never enabled by an
# install or update. The owner enables it with `systemctl enable --now`.
ConditionPathExists=/etc/jarvis/secrets/ibkr-oauth/access_token_secret

[Service]
Type=exec
# The only process holding the IBKR credentials. The socket is reachable only
# by Core's group, and the broker also checks the kernel peer uid.
User=jarvis-ibkr
Group=jarvis
Environment=JARVIS_IBKR_BROKER_ALLOWED_PEERS=jarvis
# Read by the service manager (as root) and exposed read-only to this service
# only, under fixed names. The RSA encryption key is never loaded.
LoadCredential=consumer_key:/etc/jarvis/secrets/ibkr-oauth/consumer_key
LoadCredential=access_token:/etc/jarvis/secrets/ibkr-oauth/access_token
LoadCredential=access_token_secret:/etc/jarvis/secrets/ibkr-oauth/access_token_secret
LoadCredential=signature_key:/etc/jarvis/secrets/ibkr-oauth/private_signature.pem
LoadCredential=dh_param:/etc/jarvis/secrets/ibkr-oauth/dhparam.pem
RuntimeDirectory=jarvis-ibkr-broker
RuntimeDirectoryMode=0750
ExecStart=/opt/jarvis/current/jarvis-ibkr-broker
Restart=on-failure
RestartSec=5s
TimeoutStartSec=20s
TimeoutStopSec=30s
UMask=0117
NoNewPrivileges=true
CapabilityBoundingSet=
LockPersonality=true
RestrictSUIDSGID=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectKernelLogs=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictRealtime=true
RestrictNamespaces=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# Group=jarvis must not open Core's configuration, secrets or state.
InaccessiblePaths=/etc/jarvis /var/lib/jarvis
LimitCORE=0
TasksMax=32
MemoryMax=256M

[Install]
WantedBy=multi-user.target
