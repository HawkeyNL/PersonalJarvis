[Unit]
Description=Install the latest verified Jarvis Core GitHub release
Wants=network-online.target
After=network-online.target jarvis-core.service
ConditionPathExists=/etc/jarvis/updater.env

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=/etc/jarvis/updater.env
# The Rust CLI is the sole owner-facing control plane.  Its typed update
# transaction invokes the fixed extraction helper internally where needed.
ExecStart=/usr/local/sbin/jarvis update --latest
UMask=0077

# The updater is privileged only to replace immutable releases below /opt and
# to request a restart of its single unit. It never receives Core's secrets.
NoNewPrivileges=true
CapabilityBoundingSet=
LockPersonality=true
RestrictSUIDSGID=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
# The fixed updater owns immutable releases, the canonical copies of its
# versioned tooling/application, and the fixed Jarvis unit set. Directory-level
# write access is required for same-filesystem atomic rename; caller-selected
# paths and unit names are never accepted.
ReadWritePaths=/opt/jarvis /etc/systemd/system /usr/local/sbin /usr/local/libexec/jarvis /usr/bin /usr/share/applications /usr/share/icons/hicolor/128x128/apps /usr/share/jarvis-core-admin
