[Unit]
Description=Refresh configured Jarvis provider model metadata (never enable models)
Wants=network-online.target
After=network-online.target jarvis-core.service
ConditionPathExists=/etc/jarvis/core.env
PartOf=jarvis-core.service

[Service]
Type=oneshot
User=root
Group=root
# Fixed release-owned helper, same stable policy-directory lock as CLI/broker.
ExecStart=/opt/jarvis/current/jarvis-models refresh-configured
Environment=PATH=/usr/sbin:/usr/bin:/sbin:/bin
TimeoutStartSec=5min
UMask=0077
RuntimeDirectory=jarvis-model-catalog
RuntimeDirectoryMode=0700
NoNewPrivileges=true
CapabilityBoundingSet=CAP_CHOWN CAP_FOWNER CAP_DAC_OVERRIDE
LockPersonality=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
# Helpers use atomic rename in these root-controlled configuration directories.
# No service restart or model-enable operation is part of this command.
ReadWritePaths=/etc/jarvis
MemoryMax=256M
TasksMax=32
