[Unit]
Description=Jarvis Codex chat subscription worker socket
# The coding path shares this login and stays off until the shared-token
# design is re-reviewed: starting the chat worker stops it, and vice versa.
Conflicts=jarvis-codex.service jarvis-codex-broker.service

[Socket]
ListenStream=/run/jarvis-codex-chat.sock
SocketUser=root
SocketGroup=jarvis
SocketMode=0660
RemoveOnStop=yes
Service=jarvis-codex-chat.service

[Install]
WantedBy=sockets.target
