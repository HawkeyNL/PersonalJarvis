+func isForbiddenEgressAddr(addr netip.Addr) bool {
+	addr = addr.Unmap()
+	if !addr.IsValid() || addr.IsUnspecified() || addr.IsLoopback() || addr.IsPrivate() ||
+		addr.IsLinkLocalUnicast() || addr.IsLinkLocalMulticast() || addr.IsMulticast() {
+		return true
+	}
+
+	if addr.Is4() {
+		// CGNAT (RFC 6598), the "this network" block, and benchmarking space
+		// are not public Internet destinations. RFC1918 ranges are covered by
+		// IsPrivate above.
+		return netip.MustParsePrefix("0.0.0.0/8").Contains(addr) ||
+			netip.MustParsePrefix("100.64.0.0/10").Contains(addr) ||
+			netip.MustParsePrefix("198.18.0.0/15").Contains(addr)
+	}
+
+	// IPv4-mapped addresses were unmapped above. Unique-local IPv6 is covered
+	// by IsPrivate; documentation space is intentionally rejected as well.
+	return netip.MustParsePrefix("2001:db8::/32").Contains(addr)
+}
