+func TestExtractResolvedIPs_RejectsPrivateAndSpecialUseDestinations(t *testing.T) {
+	msg := new(dns.Msg)
+	msg.Answer = []dns.RR{
+		&dns.A{Hdr: dns.RR_Header{Name: "rebind.example.", Ttl: 60}, A: net.ParseIP("127.0.0.1")},
+		&dns.A{Hdr: dns.RR_Header{Name: "rebind.example.", Ttl: 60}, A: net.ParseIP("192.168.1.1")},
+		&dns.A{Hdr: dns.RR_Header{Name: "rebind.example.", Ttl: 60}, A: net.ParseIP("172.17.0.1")},
+		&dns.A{Hdr: dns.RR_Header{Name: "rebind.example.", Ttl: 60}, A: net.ParseIP("169.254.169.254")},
+		&dns.A{Hdr: dns.RR_Header{Name: "rebind.example.", Ttl: 60}, A: net.ParseIP("100.64.0.1")},
+		&dns.AAAA{Hdr: dns.RR_Header{Name: "rebind.example.", Ttl: 60}, AAAA: net.ParseIP("::1")},
+		&dns.AAAA{Hdr: dns.RR_Header{Name: "rebind.example.", Ttl: 60}, AAAA: net.ParseIP("fc00::1")},
+		&dns.AAAA{Hdr: dns.RR_Header{Name: "rebind.example.", Ttl: 60}, AAAA: net.ParseIP("fe80::1")},
+		&dns.A{Hdr: dns.RR_Header{Name: "public.example.", Ttl: 60}, A: net.ParseIP("1.1.1.1")},
+	}
+
+	ips := extractResolvedIPs(msg)
+	require.Len(t, ips, 1, "private or special-use DNS answers must not become nft allow rules")
+	require.Equal(t, "1.1.1.1", ips[0].Addr.String())
+}
