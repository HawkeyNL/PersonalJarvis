# Production: copy outside the repository to /etc/jarvis/opensandbox.env,
# set mode 0600 root:root. Unlike Core's database file, this API key must not
# be readable by the unprivileged jarvis-core service account.
# Leave empty here: OpenSandbox refuses non-interactive unauthenticated startup.
OPENSANDBOX_SERVER_API_KEY=
# Required only while building the local control-plane image. Use an immutable
# digest, for example python:3.10-slim@sha256:<verified-digest>.
OPENSANDBOX_PYTHON_BASE_IMAGE=
# Required only while building. Use an immutable uv image digest, for example
# ghcr.io/astral-sh/uv:<verified-version>@sha256:<verified-digest>.
OPENSANDBOX_UV_IMAGE=
