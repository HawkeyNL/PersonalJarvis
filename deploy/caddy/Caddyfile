# Public Jarvis HTTPS ingress for the Ubuntu Home Node.
#
# Install this as /etc/caddy/Caddyfile and set JARVIS_PUBLIC_HOSTNAME through
# the accompanying systemd drop-in. It intentionally uses TLS-ALPN-01 only, so
# the router and firewall need to expose TCP 443 — never port 8080 or port 80.
{
	# Do not create an HTTP listener solely to redirect traffic. HTTP is not a
	# supported public Jarvis transport.
	auto_https disable_redirects
}

{$JARVIS_PUBLIC_HOSTNAME} {
	# TLS-ALPN-01 validates on TCP 443. Disabling HTTP-01 makes the one-public-
	# port requirement explicit instead of relying on firewall failure.
	tls {
		issuer acme {
			disable_http_challenge
		}
	}

	# The API is native-client oriented. It deliberately sets no browser CORS
	# policy; Tauri uses its native HTTP plugin and bearer credentials are never
	# made available to arbitrary web origins.
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	# Separate verified installation archive, never the authenticated mirror.
	@downloads path /downloads /downloads/
	handle @downloads {
		root * /var/lib/jarvis-public-downloads
		rewrite * /index.html
		header Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		header Cache-Control "public, max-age=300"
		file_server
	}
	# Only canonical IPA filenames can be downloaded. No directory browsing,
	# approval metadata, staging directories or arbitrary file extensions.
	@iosDownload path_regexp ios ^/downloads/ios/v(0|[1-9][0-9]*)[.](0|[1-9][0-9]*)[.](0|[1-9][0-9]*)/Jarvis_(0|[1-9][0-9]*)[.](0|[1-9][0-9]*)[.](0|[1-9][0-9]*)_ios_arm64_unsigned[.]ipa$
	handle @iosDownload {
		root * /var/lib/jarvis-public-downloads
		uri strip_prefix /downloads
		header Content-Disposition attachment
		header Cache-Control "public, max-age=3600, immutable"
		file_server
	}

	# All API routes, including /v1/app-updates/** and /v1/events, keep their
	# existing Core authentication. No public mirror alias or directory listing.
	# Caddy overwrites incoming X-Forwarded-*; Core trusts only its loopback peer.
	handle {
		reverse_proxy 127.0.0.1:8080
	}
}
