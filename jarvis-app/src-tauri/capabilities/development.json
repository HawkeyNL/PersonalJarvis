{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "development",
  "description": "Explicit debug-only loopback HTTP access",
  "windows": ["main"],
  "permissions": [
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://localhost:8080/*" },
        { "url": "http://127.0.0.1:8080/*" }
      ]
    }
  ]
}
