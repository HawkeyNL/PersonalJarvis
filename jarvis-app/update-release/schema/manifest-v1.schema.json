{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.jarvis.local/app-release-manifest-v1.json",
  "title": "Jarvis private application release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "release", "artifacts"],
  "properties": {
    "schema_version": { "const": 1 },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "channel", "released_at", "minimum_client_protocol"],
      "properties": {
        "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$" },
        "channel": { "enum": ["stable", "beta", "development"] },
        "released_at": { "type": "string", "format": "date-time" },
        "minimum_client_protocol": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "notes": { "type": "string", "minLength": 1, "maxLength": 8192 }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["platform", "architecture", "distribution", "signature"],
        "properties": {
          "platform": { "enum": ["windows", "macos", "linux", "android", "ios"] },
          "architecture": { "enum": ["x86_64", "arm64", "universal"] },
          "distribution": { "enum": ["home-node-updater", "home-node-apk", "testflight"] },
          "artifact": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256", "size"],
            "properties": {
              "path": { "type": "string", "minLength": 1, "maxLength": 512 },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "size": { "type": "integer", "minimum": 1 }
            }
          },
          "external": {
            "type": "object",
            "additionalProperties": false,
            "required": ["bundle_id", "build_number"],
            "properties": {
              "bundle_id": { "const": "com.hawkeynl.jarvis" },
              "build_number": { "type": "string", "pattern": "^[1-9][0-9]*$" }
            }
          },
          "metadata": {
            "type": "object",
            "additionalProperties": false,
            "required": ["version_code"],
            "properties": {
              "version_code": { "type": "integer", "minimum": 1 }
            }
          },
          "signature": {
            "type": "object",
            "additionalProperties": false,
            "required": ["scheme", "value"],
            "properties": {
              "scheme": { "enum": ["tauri-minisign", "android-apk-signing-certificate-sha256", "apple-code-signing"] },
              "value": { "type": "string", "minLength": 1, "maxLength": 16384 }
            }
          }
        }
      }
    }
  }
}
